	if isMenuOpen then
		mainFrame.Visible = true
		mainFrame.Size = UDim2.new(0, 480, 0, 330)
		mainFrame.GroupTransparency = 1

		TweenService:Create(mainFrame, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 540, 0, 380),
			GroupTransparency = 0
		}):Play()
	else
		local closeTween = TweenService:Create(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 470, 0, 320),
			GroupTransparency = 1
		})
		closeTween:Play()
		closeTween.Completed:Connect(function()
			if not isMenuOpen then
				mainFrame.Visible = false
			end
		end)
	end
end

